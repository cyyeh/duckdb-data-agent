{
  "$schema": "https://www.getbifrost.ai/schema",
  "config_store": {
    "enabled": false
  },
  "providers": {
    "anthropic": {
      "keys": [
        {
          "name": "default",
          "value": "env.ANTHROPIC_API_KEY",
          "models": [],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300
      }
    },
    "openai": {
      "keys": [
        {
          "name": "default",
          "value": "env.OPENAI_API_KEY",
          "models": [],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300
      }
    }
  }
}
