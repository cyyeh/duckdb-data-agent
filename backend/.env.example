ANTHROPIC_API_KEY=your-api-key-here
# Model configuration. Use @suffix for per-agent model routing via a proxy:
#   ORCHESTRATOR_MODEL=openai/gpt-4o@sonnet           (orchestrator: sonnet alias -> openai/gpt-4o)
#   SQL_SUBAGENT_MODEL=openai/gpt-4o-mini@haiku    (sql agent: haiku alias -> openai/gpt-4o-mini)
# WARNING: The @suffix must NOT match the ORCHESTRATOR_MODEL's Anthropic model name.
#   e.g. ORCHESTRATOR_MODEL=haiku with SQL_SUBAGENT_MODEL=openai/gpt-4o-mini@haiku
#   will conflict because the proxy cannot distinguish orchestrator traffic from
#   subagent traffic when both resolve to the same "haiku" model name.
# Without @suffix, value is used as-is (direct Anthropic):
#   ORCHESTRATOR_MODEL=claude-sonnet-4-6
#   SQL_SUBAGENT_MODEL=haiku
ORCHESTRATOR_MODEL=claude-sonnet-4-6
SQL_SUBAGENT_MODEL=haiku
# Default model for SDK built-in tools (e.g. WebFetch uses claude-haiku-4-5-20251001 internally).
# When set, any model not matched by the rewrite map above is rewritten to this value.
# Example: DEFAULT_TOOL_MODEL=openai/gpt-4o-mini
DEFAULT_TOOL_MODEL=

# Bifrost LLM Gateway (manages API keys and multi-provider routing)
# These are auto-configured by `make dev` and docker-compose.yml respectively.
# Only override if running the backend manually outside of those workflows.
# BIFROST_BASE_URL=http://localhost:8081   (make dev)
# BIFROST_BASE_URL=http://bifrost:8080        (docker compose, default)
# BACKEND_BASE_URL=http://host.docker.internal:8000  (make dev)
# BACKEND_BASE_URL=http://duckdb-data-agent:10000    (docker compose, default)

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Maximum total upload file size in bytes (default: 500MB)
MAX_TOTAL_SIZE_BYTES=524288000

# Container settings (Docker required)
CONTAINER_IMAGE=duckdb-agent-sidecar:latest
CONTAINER_RUNTIME=runc  # use `runsc` for gVisor
CONTAINER_MEMORY_LIMIT=512m
CONTAINER_CPU_LIMIT=0.5
CONTAINER_MAX_LIFETIME_SECONDS=3600
CONTAINER_IDLE_TIMEOUT_SECONDS=300
CONTAINER_NETWORK=agent-sandbox
# SDK idle timeout in milliseconds — aborts if no SDK message arrives within
# this window (resets on every message). Default: 120000 (2 minutes)
SDK_IDLE_TIMEOUT_MS=120000
# Skills directory (where SKILL.md files are stored)
# SKILLS_DIR is the path inside the app container; SKILLS_HOST_PATH is the
# Docker host path used when spawning sidecar containers via Docker SDK.
# SKILLS_DIR=/app/sidecar/.claude/skills
# SKILLS_HOST_PATH=./sidecar/.claude/skills
# Comma-separated list of allowed CORS origins (default: localhost dev servers)
# CORS_ALLOWED_ORIGINS=https://myapp.example.com
